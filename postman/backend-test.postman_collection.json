{
  "info": {
    "name": "backend-test",
    "description": "Ручное тестирование backend-test API. Импортируй коллекцию, подними стек (`docker compose up -d --build`) и жми запросы по порядку сверху вниз внутри каждой папки — токены, id заказов и вебхуков подхватываются автоматически через test-скрипты в переменные коллекции.\n\nТестовые пользователи: admin@test.com/admin123 (ADMIN), alice@test.com/alice123, bob@test.com/bob12345, carol@test.com/carol123 (USER). OAuth client_credentials: test-client/test-secret.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "tokenAlice", "value": "" },
    { "key": "tokenBob", "value": "" },
    { "key": "tokenAdmin", "value": "" },
    { "key": "tokenClient", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "orderEtag", "value": "" },
    { "key": "secondOrderId", "value": "" },
    { "key": "newUserId", "value": "" },
    { "key": "webhookId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Health & Actuator",
      "item": [
        {
          "name": "GET /api/health (без токена)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
          },
          "response": []
        },
        {
          "name": "GET /actuator/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/actuator/health", "host": ["{{baseUrl}}"], "path": ["actuator", "health"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "POST /auth/register (новый юзер)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Tester\",\n  \"email\": \"postman.tester+{{$timestamp}}@test.com\",\n  \"password\": \"tester123\",\n  \"age\": 30\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"] },
            "description": "Ожидаем 201 и роль USER. Повтори с тем же email второй раз — жди 409/400 на дубликат."
          },
          "response": []
        },
        {
          "name": "POST /auth/login (alice)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('tokenAlice', data.token);",
                  "pm.test('200 и токен получен', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(data.token).to.be.a('string');",
                  "    pm.expect(data.role).to.eql('USER');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@test.com\",\n  \"password\": \"alice123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          },
          "response": []
        },
        {
          "name": "POST /auth/login (bob)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('tokenBob', data.token);",
                  "pm.test('200 и токен получен', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bob@test.com\",\n  \"password\": \"bob12345\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          },
          "response": []
        },
        {
          "name": "POST /auth/login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('tokenAdmin', data.token);",
                  "pm.test('200 и роль ADMIN', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(data.role).to.eql('ADMIN');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"admin123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          },
          "response": []
        },
        {
          "name": "POST /auth/login (короткий TTL, test hook)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@test.com\",\n  \"password\": \"alice123\",\n  \"expiresInSeconds\": 5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] },
            "description": "Подожди 5+ секунд и вызови /auth/me с этим токеном — жди 401, чтобы вручную проверить истечение JWT."
          },
          "response": []
        },
        {
          "name": "POST /auth/token (OAuth client_credentials)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('tokenClient', data.token);",
                  "pm.test('200 и роль ADMIN у сервисного токена', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(data.role).to.eql('ADMIN');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials" },
                { "key": "client_id", "value": "test-client" },
                { "key": "client_secret", "value": "test-secret" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/token", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "token"] }
          },
          "response": []
        },
        {
          "name": "GET /auth/me (alice)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenAlice}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "me"] }
          },
          "response": []
        },
        {
          "name": "GET /auth/me (без токена -> 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "me"] }
          },
          "response": []
        }
      ]
    },
