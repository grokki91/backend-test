            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dave\",\n  \"email\": \"dave+{{$timestamp}}@test.com\",\n  \"password\": \"dave1234\",\n  \"age\": 25\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/users", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users"] }
