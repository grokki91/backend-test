    {
      "name": "4. Orders",
      "item": [
        {
          "name": "POST /orders (create, Idempotency-Key)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('orderId', data.id);",
                  "pm.collectionVariables.set('orderEtag', pm.response.headers.get('ETag'));",
                  "pm.test('201 Created, статус NEW', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(data.status).to.eql('NEW');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenAlice}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "postman-demo-key-1" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 42.50,\n  \"currency\": \"USD\",\n  \"comment\": \"Собрано руками через Postman\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/orders", "host": ["{{baseUrl}}"], "path": ["api", "v1", "orders"] }
          },
          "response": []
        },
        {
          "name": "POST /orders (тот же Idempotency-Key -> replay)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 + Idempotency-Replayed: true, id не изменился', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.headers.get('Idempotency-Replayed')).to.eql('true');",
                  "    pm.expect(pm.response.json().id).to.eql(parseInt(pm.collectionVariables.get('orderId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenAlice}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "postman-demo-key-1" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 42.50,\n  \"currency\": \"USD\",\n  \"comment\": \"Собрано руками через Postman\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/orders", "host": ["{{baseUrl}}"], "path": ["api", "v1", "orders"] },
            "description": "Тот же ключ, то же тело -> сервер не создаёт второй заказ, отдаёт исходный с заголовком Idempotency-Replayed: true."
          },
          "response": []
        },
        {
          "name": "POST /orders (второй заказ, для негативных сценариев)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('secondOrderId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenAlice}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "postman-demo-key-2" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 10.00,\n  \"currency\": \"EUR\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/orders", "host": ["{{baseUrl}}"], "path": ["api", "v1", "orders"] }
          },
          "response": []
        },
        {
          "name": "GET /orders?status=NEW",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenAlice}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders?status=NEW&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders"],
              "query": [
                { "key": "status", "value": "NEW" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /orders/{{orderId}} (обновляет ETag)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('orderEtag', pm.response.headers.get('ETag'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenAlice}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "orders", "{{orderId}}"] }
          },
          "response": []
        },
        {
          "name": "GET /orders/{{orderId}} (bob, чужой заказ -> 403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenBob}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "orders", "{{orderId}}"] }
          },
          "response": []
        },
        {
          "name": "PATCH /orders/{{orderId}} (с верным If-Match)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('orderEtag', pm.response.headers.get('ETag'));",
                  "}",
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenAlice}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "If-Match", "value": "{{orderEtag}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 55.00\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "orders", "{{orderId}}"] }
          },
          "response": []
        },
        {
          "name": "PATCH /orders/{{orderId}} (устаревший If-Match -> 409)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenAlice}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "If-Match", "value": "\"0\"" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 999.00\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "orders", "{{orderId}}"] },
            "description": "Заведомо устаревшая версия — проверка оптимистичной блокировки. Ожидаем 409."
          },
          "response": []
        },
        {
          "name": "POST /orders/{{orderId}}/pay",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenAlice}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}/pay", "host": ["{{baseUrl}}"], "path": ["api", "v1", "orders", "{{orderId}}", "pay"] }
